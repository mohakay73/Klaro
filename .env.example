# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Parsing Configuration (Supports Google Gemini [Free], OpenAI, or Anthropic)
AI_PROVIDER=gemini # or openai, anthropic
GEMINI_API_KEY=your-gemini-api-key # Get free key at https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-3-flash-preview
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Open Banking PSD2 Integration (Tink / Enable Banking)
OPEN_BANKING_PROVIDER=tink
TINK_CLIENT_ID=your-tink-client-id
TINK_CLIENT_SECRET=your-tink-client-secret
TINK_ENVIRONMENT=sandbox # or production

# Resend Inbound Email Webhook
RESEND_API_KEY=your-resend-api-key
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
